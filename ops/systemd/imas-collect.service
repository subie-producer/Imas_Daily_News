[Unit]
Description=アイマスNEWS 収集(定点観測+Claude探索+Grok X調査)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/git/Imas_Daily_News
Environment=PATH=%h/.local/bin:%h/.grok/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/git/Imas_Daily_News/scripts/collect.py
TimeoutStartSec=30min
