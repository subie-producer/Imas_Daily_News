# ローカル実行用の環境変数置き場。
# このファイルを .env にコピーして値を記入する(.env は git 管理外)。
#   cp .env.example .env

# 異常通知先の Discord webhook(PIPELINE.md §7)
DISCORD_WEBHOOK_URL=

# 校閲に使うモデル(codex exec -m に渡す)
REVIEW_MODEL=gpt-5.6-terra

# 執筆・探索に使う Claude モデル(claude -p --model に渡す)
CLAUDE_MODEL=sonnet

# 号数モード: test=第0号(試験発行) / live=連番(創刊後)
PAPER_STAGE=test
