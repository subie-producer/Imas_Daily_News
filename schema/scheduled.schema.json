{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scheduled",
  "description": "日付別の続報予約(素材スナップショット同梱)。stock/scheduled/YYYY-MM-DD.json = その日の compose が消化する予約。予約後は原則変更しない(検証可能性)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "dedup_key", "brand", "subject", "kind", "reserved_on", "facts"],
    "additionalProperties": false,
    "properties": {
      "id": {"type": "string", "minLength": 1, "description": "予約の一意ID(sched-<日付>-<dedup_key>-<kind>)"},
      "dedup_key": {"type": "string", "minLength": 1},
      "brand": {"enum": ["general", "765", "cg", "million", "shiny", "sidem", "gaku", "dsva", "joint", "other"]},
      "subject": {"type": "string", "minLength": 1, "description": "話題の件名"},
      "kind": {"enum": ["締切前", "締切", "開幕", "千秋楽", "発売", "結果", "終了", "開始", "その他"], "description": "トリガー種別"},
      "note": {"type": "string"},
      "reserved_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "予約した日(初報の compose 日)"},
      "title": {"type": "string", "description": "素材スナップショット: 元候補の title"},
      "url": {"type": "string", "description": "素材スナップショット: 出典 URL(記事の sources に使える)"},
      "source_type": {"enum": ["公式", "準公式", "当事者", "報道", "ファン", "もちより", "未確認"]},
      "facts": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "素材スナップショット: 予約時点で確認済みの事実"},
      "via": {"type": "string"},
      "verify": {"enum": ["confirmed", "unconfirmed", "failed"]},
      "event_date": {"type": "string"},
      "deadline": {"type": "string"},
      "src_candidate_id": {"type": "string", "description": "スナップショット元の candidates id(監査用)"}
    }
  }
}
