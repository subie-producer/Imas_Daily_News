{
  "title": "oncall-integrate",
  "description": "当番(Opus)のレビューへの返事。blocking の1件ずつに fixed か disagree を返す",
  "type": "object",
  "required": ["replies", "changed_files", "test_evidence", "status", "rerun_mode", "editor_summary", "diagnosis", "root_cause", "recovery", "risk", "notes"],
  "additionalProperties": false,
  "properties": {
    "replies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reply", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "reply": {"enum": ["fixed", "disagree"]},
          "evidence": {"type": "string", "maxLength": 600, "description": "fixed: どう直したか / disagree: 当たらない根拠(コードの該当行・再現しない入力・実測)"}
        }
      }
    },
    "editor_summary": {
      "type": ["object", "null"],
      "required": ["what_happened", "why", "what_changed"],
      "additionalProperties": false,
      "description": "直した内容が変わったときだけ、書き直した報告(各欄1〜2文)。変わらなければ null",
      "properties": {
        "what_happened": {"type": "string", "minLength": 1, "maxLength": 400},
        "why": {"type": "string", "minLength": 1, "maxLength": 400},
        "what_changed": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "status": {"enum": ["unchanged", "fixed", "no_fix_needed", "cannot_fix"], "description": "結論を改めるなら新しい値。変えないなら unchanged"},
    "rerun_mode": {"enum": ["unchanged", "rebuild", "resume", "none"], "description": "再実行の仕方を改めるなら新しい値。変えないなら unchanged"},
    "diagnosis": {"type": "string", "maxLength": 800, "description": "診断を改めたなら新しい診断。変えないなら空文字"},
    "root_cause": {"type": "string", "maxLength": 400, "description": "原因を改めたなら新しい原因。変えないなら空文字"},
    "recovery": {"type": "string", "maxLength": 600, "description": "no_fix_needed に改めたときの、同じ入力で今度は通る根拠。それ以外は空文字"},
    "risk": {"type": "string", "maxLength": 400, "description": "この巡の変更で新しく壊れうるもの。変えないなら空文字"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "test_evidence": {"type": "string", "maxLength": 600},
    "notes": {"type": "string", "maxLength": 600}
  }
}
