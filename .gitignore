# Jekyll ローカルビルド
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/Gemfile.lock
docs/vendor/
docs/.bundle/

# Python
__pycache__/
*.pyc
.venv/

# ローカル環境変数(雛形は .env.example)
.env

# Grok の作業ファイル(プロンプトと生の応答。candidates/<日付>.json に取り込まれるので
# リポジトリには残さない。collect が commit 前に git add -A するため明示的に除外する)
candidates/.grok/

# 選定用の主題インデックス(candidates から機械生成される派生物)
metrics/plan-index-*.json
# 当番(oncall)の状態・記録は Git 管理外(作業ツリーを dirty にすると再実行が拒否される。監査指摘)
metrics/oncall-*
# 工程の排他(flock)。中身は無い
metrics/*.lock
