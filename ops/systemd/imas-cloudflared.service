[Unit]
Description=アイマスNEWS 配信のトンネル(cloudflared)を最新の版に上げ、つながることを確かめる(だめなら旧版に戻す)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/git/imas-ops
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/git/imas-ops/scripts/update_cloudflared.py
# 追いつきの起動が発行の時間帯(02:30〜07:00)に当たると、07:00 まで待ってから上げる(最長 4.5 時間+更新 20 分)
TimeoutStartSec=5h
