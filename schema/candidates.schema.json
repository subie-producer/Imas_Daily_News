{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidates.schema.json",
  "title": "収集候補 (candidates/YYYY-MM-DD.json)",
  "description": "collect 層(REQUIREMENTS.md 4.1)が正規化して蓄積する候補。verify 層が verify フィールドを更新する。記事の sources に現れる URL はいずれかの candidates に存在しなければならない(出典 lint)。",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "brand",
      "source_type",
      "url",
      "found_at",
      "dedup_key",
      "verify"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "description": "候補の一意 ID"
      },
      "title": {
        "type": "string"
      },
      "brand": {
        "enum": [
          "general",
          "765",
          "cg",
          "million",
          "shiny",
          "sidem",
          "gaku",
          "dsva",
          "joint",
          "other"
        ]
      },
      "source_type": {
        "enum": [
          "公式",
          "準公式",
          "当事者",
          "報道",
          "ファン",
          "二次情報",
          "もちより",
          "未確認"
        ]
      },
      "url": {
        "type": "string",
        "pattern": "^https?://"
      },
      "found_at": {
        "type": "string",
        "description": "発見日時(ISO 8601, JST)"
      },
      "event_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "published_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "情報の初出日(ページ掲載日・ポスト投稿日)。鮮度判定(verify)と新規性表現の裏取りに使う"
      },
      "dedup_key": {
        "type": "string",
        "description": "重複排除キー"
      },
      "facts": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "一次ソースから抽出した事実の列挙。記事はここに無い事実を書かない"
      },
      "periods": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "期間ラベル規程(REQUIREMENTS.md 4.6 相当)向けの期間抽出。「何の期間か」を出典の語で明示した文字列(例: 受付期間/当落発表/入金期間)。facts の補助情報で、収集層が期間の種別混同を防ぐために付与する"
      },
      "origin": {
        "enum": [
          "watch",
          "explore"
        ],
        "description": "watch=定点観測(sources.yml) / explore=探索(Web検索・Grok)。ランキングのトレンド分は explore 由来の言及を数える"
      },
      "via": {
        "enum": [
          "watch",
          "explore",
          "claude",
          "grok"
        ],
        "description": "収集経路(定点観測 / 探索 / Grok X調査)。claude は探索役が Claude だった頃の旧値で、過去の候補ファイルのために残している"
      },
      "deadline": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "締切・終了日(続報キューのトリガー予約に使う)"
      },
      "verify": {
        "enum": [
          "confirmed",
          "unconfirmed",
          "failed"
        ],
        "description": "verify 層の照合結果。探索由来は登録時 unconfirmed"
      },
      "verify_note": {
        "type": "string",
        "description": "verify 結果の補足(failed の理由など。人間とパイプラインの診断用)"
      }
    }
  }
}
