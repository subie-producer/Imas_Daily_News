{
  "title": "oncall-review",
  "description": "監査(Sol)の PR レビュー",
  "type": "object",
  "required": ["verdict", "verification", "comments", "resolutions", "notes"],
  "additionalProperties": false,
  "properties": {
    "verdict": {"enum": ["approve", "request_changes"]},
    "verification": {
      "type": "array",
      "minItems": 1,
      "description": "実際に走らせたコマンドと、その終了コード・結果(最後の行など)。走らせていない確認は書かない",
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "result"],
        "additionalProperties": false,
        "properties": {
          "command": {"type": "string", "maxLength": 300},
          "exit_code": {"type": ["integer", "null"], "description": "プロセスの終了コード。走らせられなかった・終わらなかったときは null"},
          "result": {"type": "string", "maxLength": 400}
        }
      }
    },
    "comments": {
      "type": "array",
      "description": "差分の行に付けるコメント",
      "items": {
        "type": "object",
        "required": ["id", "file", "line", "kind", "claim", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "file": {"type": "string", "maxLength": 200, "description": "差分のファイル。差分が無い PR の診断へのコメントは空文字"},
          "line": {"type": "integer", "minimum": 0, "description": "変更後のファイルの行番号。差分が無い PR の診断へのコメントは 0"},
          "kind": {"enum": ["blocking", "nit"], "description": "blocking=原因に当たっていない・ほかを壊す・してはいけない直し方の3つだけ / nit=それ以外"},
          "claim": {"type": "string", "maxLength": 400, "description": "何が問題か(1文)"},
          "evidence": {"type": "string", "maxLength": 600, "description": "根拠(再現した入力・実データ・実測・ファイル:行)。推測なら (推測) と書く"}
        }
      }
    },
    "resolutions": {
      "type": "array",
      "description": "前の巡の blocking の1件ずつの解決。1巡目は空",
      "items": {
        "type": "object",
        "required": ["id", "status", "why"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["resolved", "unresolved"]},
          "why": {"type": "string", "maxLength": 400}
        }
      }
    },
    "notes": {"type": "string", "maxLength": 800}
  }
}
