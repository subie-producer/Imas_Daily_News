[Unit]
Description=アイマスNEWS の工程(定時の工程と当番)のメモリの上限
# 工程と当番をまとめて上限を掛け、どれかが膨らんでも機械を止めない(2026-10-27: 09:00 の watch が 6.4G・スワップ 1.3G を使い、
# 09:05〜16:38 は機械全体が止まって journal に記録が無く、12:30 の収集も起動しなかった。10/26 も 09:00 の watch のあと止まった)。
# 機械は 7.6G(スワップ 2G)。常駐(web・app・トンネル 各 60M 以下)・sshd・手元の作業に 1.6G 残す。
# 上限は工程の合計(並んで走る収集の当番と組版を含む)。実測のピーク(journal の memory peak。ファイルのキャッシュを含む)は
# 収集 6.1G・組版 4.9G・道具の更新 1.7G・watch 0.5G・発行 0.4G で、キャッシュは上限に近づくと手放されるので、
# 上限に掛かるのは手放せない分(匿名メモリ)だけ

[Slice]
# ここを越えると回収と減速が掛かる(殺さない)
MemoryHigh=5500M
# ここを越えたら OOM killer が工程の中だけで殺す(機械の他を守る)。殺された工程は OnFailure で人と当番に届く
MemoryMax=6G
# スワップに逃がして機械全体を遅くしない
MemorySwapMax=1G
