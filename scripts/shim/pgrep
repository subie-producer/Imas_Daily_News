#!/bin/sh
# 当番・監査のセッションの pgrep / pkill(oncall.session_env が PATH の先頭に置く。pkill はこのファイルへのリンク)。
# 本物を -A(自分の祖先を除く)付きで呼ぶ。待ちのループを回すシェル・セッションの CLI・当番自身は、コマンド行に名前を含んでいても
# 当たらない・止められない。2026-10-25 12:31 の当番は `until ! pgrep -f "scripts/selfcheck.py"` が自分のシェルに当たって
# 600 秒待ち、`pkill -f "pgrep -f scripts/selfcheck"` で自分のテストを止めた。
here=$(cd "$(dirname "$0")" && pwd)
p=
IFS=:
for d in $PATH; do
    [ "$d" = "$here" ] || p="${p:+$p:}$d"
done
unset IFS
PATH=$p
export PATH
exec "$(basename "$0")" -A "$@"
