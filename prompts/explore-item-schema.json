      },
      "brand": {
        "type": "string",
        "enum": [
          "general",
          "765",
          "cg",
          "million",
          "shiny",
          "sidem",
          "gaku",
          "dsva",
          "joint",
          "other"
        ]
      },
      "kind": {
        "type": "string",
        "enum": [
          "official",
          "semi",
          "party",
          "media",
          "fan",
          "trend"
