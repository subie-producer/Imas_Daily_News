# ローカル実行用の環境変数置き場。
# このファイルを .env にコピーして値を記入する(.env は git 管理外)。
#   cp .env.example .env

# 異常通知先の Discord webhook(PIPELINE.md §7)
DISCORD_WEBHOOK_URL=

# 記事本文の執筆に使う Codex モデル(codex exec -m に渡す)。校閲(Claude)と別ベンダーにする
CODEX_WRITE_MODEL=gpt-6-luna

# 社説の執筆に使う Codex モデル。記事とは求めるものが違う(事実の要約ではなく人格と文章)
EDITORIAL_MODEL=gpt-6.1-sol

# 校閲・検品(機械検収エラー修正・lint修正)に使う Claude モデル(claude -p --model に渡す)。
# 執筆(Codex)と別ベンダーにするため Claude 側。検品はコスト重視で既定 haiku
REVIEW_MODEL=haiku

# 記事計画・組版に使う Claude モデル(claude -p --model に渡す)。社説は EDITORIAL_MODEL 側。
# 短縮名 sonnet は Sonnet 5 を指したままなので、版を明示する
CLAUDE_MODEL=claude-sonnet-5-5

# 収集(定点観測+探索)に使う Claude モデル。執筆より要求精度が低いため既定は haiku。
# verify の failed/unconfirmed 比率が悪化したら sonnet に戻す
COLLECT_MODEL=haiku

# Grok(X動向)を回す時刻。JST の「時」をカンマ区切り。空なら収集のたびに回す。
# **collect の timer と compose(04:00)の間に収まる時刻にすること。**
# 深掘り回は長時間かかるため 02:00 に置き、service の TimeoutStartSec も 100分にしてある。
# SuperGrok は週次のセッション上限があり、1回の収集で10セッション(ブランド10面)を
# 消費する。収集そのものは安価な Haiku なので頻度を保ち、Grok の回数だけをここで絞る。
#   日5回すべてで回す = 350セッション/週(上限の約3倍)
#   03,18 の2回      = 140セッション/週
#   03 のみ          =  70セッション/週
# ブランドは減らさない(絞るのは実行回数だけ)。締切前スイープの 03 は外さないこと
GROK_HOURS=02
# Grok の週次上限の X 検索回数と、深掘りに使ってよい割合・1回の上限(数えるのは X の検索だけ)
GROK_WEEKLY_SEARCHES=1100
GROK_DEEP_SHARE=0.8
GROK_DEEP_MAX=24

# 定点観測の新着を facts 化する1バッチの件数(1回の Claude 呼び出しに載る量)。新着は件数にかかわらず
# 全部を処理し、バッチは WATCH_PARALLEL 本ずつ同時に走らせる
WATCH_BATCH=12

# 暴走セッション対策の安全弁(claude -p --max-budget-usd)。通常運用では到達しない額の目安
# 注: codex exec には同等のフラグが無いため、codex 側(探索・執筆・社説)には適用されない。
# 探索の暴走を止めるのは EXPLORE_TIMEOUT だけである
# ※ 名前は「探索の」だが、現在この値を使うのは**定点観測の facts 化(Claude)**のみ。
#    探索役は Luna(codex)へ移ったため(2026-08-29)
EXPLORE_MAX_BUDGET_USD=1.5
# 探索(Luna)1クエリの打ち切り秒数。起動時から数える
EXPLORE_TIMEOUT=900
COMPOSE_ARTICLE_MAX_BUDGET_USD=3
COMPOSE_WHOLE_MAX_BUDGET_USD=8

# 号数モード: test=第0号(試験発行) / live=連番(創刊後)
PAPER_STAGE=test

# ---- 配信(自前オリジン + Cloudflare Tunnel) ----
# 公開URL。jekyll の url に渡り、feed/sitemap/OGP の絶対URLになる
SITE_URL=https://example.com

# 配信ルート(releases/ と current symlink を置く場所)
SRV_ROOT=/home/akabanep/srv/imas-news
# 保持する過去リリース世代数(切り戻し用)
KEEP_RELEASES=5

# 発行時に Cloudflare のエッジキャッシュをパージするための資格情報。
# 未設定ならパージを省略する(s-maxage が長いため更新が最大1日届かなくなる点に注意)。
# トークンは Zone:Cache Purge:Purge 権限のみを付けたものを使う
CF_API_TOKEN=
CF_ZONE_ID=
EXPLORE_MODEL=gpt-6-luna
