{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "article.schema.json",
  "title": "記事 frontmatter (docs/_posts/YYYY-MM-DD-<slug>.md)",
  "description": "REQUIREMENTS.md 3.1 のデータ契約。字数の目安(見出し45字・lede 60〜100字)は lint が警告として扱うためスキーマでは強制しない。",
  "type": "object",
  "required": ["slug", "edition", "brand", "src", "rank", "title", "lede", "sources", "corrected", "corrections"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "一意。URL(/articles/<slug>/)になる。ファイル名の <slug> 部と一致すること(lint 検査)"
    },
    "edition": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "所属号(=発行日)。ファイル名の日付部と一致すること(lint 検査)"
    },
    "brand": {
      "enum": ["general", "765", "cg", "million", "shiny", "sidem", "gaku", "dsva", "joint", "other"]
    },
    "src": {
      "enum": ["公式", "報道", "ファン", "もちより", "未確認"]
    },
    "rank": {
      "enum": ["lead", "large", "medium", "small"],
      "description": "lead は号内で1本のみ(lint 検査)"
    },
    "title": { "type": "string", "minLength": 1 },
    "lede": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "label", "url"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["公式", "報道", "ファン", "もちより", "未確認"] },
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "corrected": { "type": "boolean" },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "by", "initial", "corrected_to"],
        "additionalProperties": false,
        "properties": {
          "at": { "type": "string", "description": "訂正日時(ISO 8601, JST)" },
          "by": { "type": "string", "description": "訂正の契機(読者指摘・校閲AIの再指摘 等)" },
          "initial": { "type": "string", "description": "初出の表記" },
          "corrected_to": { "type": "string", "description": "訂正後の表記" },
          "note": { "type": "string" }
        }
      }
    },
    "event_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "出来事の発生日(任意)"
    }
  }
}
