[Unit]
Description=アイマスNEWS 配信サーバー(Caddy と webapp の依存)の新しい版と脆弱性を見て、重大なものは合議で上げる(だめなら戻す)
Wants=network-online.target
After=network-online.target
OnFailure=imas-failure@%n.service

[Service]
Slice=imas.slice
MemoryMax=3G
Type=oneshot
WorkingDirectory=%h/git/imas-ops
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/git/imas-ops/scripts/update_server.py
# 最長: 合議(1本 30 分 × 2人 × 2巡)+障壁の案と査読(30 分 × 2 × 2往復)で約 4 時間。追いつきの起動が発行の時間帯に当たると
# 再起動の前に 07:00 まで待つ(最長 4.5 時間)。余裕を見て 10 時間
TimeoutStartSec=10h
