        "description": "official=アイマス公式のみ/semi=公式レーベル・公式ストア等/party=その他の当事者/media=報道/fan=ファン発/trend=現象"
      },
      "url": {
        "type": "string",
        "description": "一次ソースまたは代表ポストのURL(実在するもののみ)"
      },
      "event_date": {
        "type": "string",
        "description": "出来事・開始日 YYYY-MM-DD(不明なら空文字)"
