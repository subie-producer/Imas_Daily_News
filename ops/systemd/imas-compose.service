[Unit]
Description=アイマスNEWS 紙面生成(Claude執筆+derive+Codex校閲)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/git/imas-ops
Environment=PATH=%h/.local/bin:%h/.grok/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/git/imas-ops/scripts/compose.py
TimeoutStartSec=100min
