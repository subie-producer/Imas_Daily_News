# ローカル実行用の環境変数置き場。
# このファイルを .env にコピーして値を記入する(.env は git 管理外)。
#   cp .env.example .env

# 異常通知先の Discord webhook(PIPELINE.md §7)
DISCORD_WEBHOOK_URL=

# 記事本文の執筆に使う Codex モデル(codex exec -m に渡す)。校閲(Claude)と別ベンダーにする
CODEX_WRITE_MODEL=gpt-5.6-luna

# 校閲・検品(機械検収エラー修正・lint修正)に使う Claude モデル(claude -p --model に渡す)。
# 執筆(Codex)と別ベンダーにするため Claude 側。検品はコスト重視で既定 haiku
REVIEW_MODEL=haiku

# 記事計画・社説・組版に使う Claude モデル(claude -p --model に渡す)
CLAUDE_MODEL=sonnet

# 収集(定点観測+探索)に使う Claude モデル。執筆より要求精度が低いため既定は haiku。
# verify の failed/unconfirmed 比率が悪化したら sonnet に戻す
COLLECT_MODEL=haiku

# 定点観測の新着を1回の実行で facts 化する上限。1回の Claude 呼び出しに載る量で区切る
# だけで、超過分は次回へ繰り越すため取りこぼしにはならない。長期停止明けで新着が
# 積み上がっているときは一時的に上げると消化が早い
WATCH_BATCH=12

# 暴走セッション対策の安全弁(claude -p --max-budget-usd)。通常運用では到達しない額の目安
# 注: codex exec には同等のフラグが無いため CODEX_WRITE_MODEL 側には適用されない
EXPLORE_MAX_BUDGET_USD=1.5
COMPOSE_ARTICLE_MAX_BUDGET_USD=3
COMPOSE_WHOLE_MAX_BUDGET_USD=8

# 号数モード: test=第0号(試験発行) / live=連番(創刊後)
PAPER_STAGE=test

# ---- 配信(自前オリジン + Cloudflare Tunnel) ----
# 公開URL。jekyll の url に渡り、feed/sitemap/OGP の絶対URLになる
SITE_URL=https://example.com

# 配信ルート(releases/ と current symlink を置く場所)
SRV_ROOT=/home/akabanep/srv/imas-news
# 保持する過去リリース世代数(切り戻し用)
KEEP_RELEASES=5

# 発行時に Cloudflare のエッジキャッシュをパージするための資格情報。
# 未設定ならパージを省略する(s-maxage が長いため更新が最大1日届かなくなる点に注意)。
# トークンは Zone:Cache Purge:Purge 権限のみを付けたものを使う
CF_API_TOKEN=
CF_ZONE_ID=
